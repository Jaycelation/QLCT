# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_app?schema=public"
# Separate database used by `pnpm test` (wiped on every run)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_app_test?schema=public"
# IANA timezone used to decide what "today" is for dates and recurring transactions
APP_TIMEZONE="Asia/Ho_Chi_Minh"
